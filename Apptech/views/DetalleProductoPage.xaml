<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Apptech.views.DetalleProductoPage"
             Title="Detalle del Producto"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            
            <Border StrokeShape="RoundRectangle 15" StrokeThickness="0" HeightRequest="300">
                <Image Source="{Binding ImagenUrl}" Aspect="AspectFill" />
            </Border>

            <Frame BackgroundColor="#e74c3c" 
                   BorderColor="Transparent"
                   CornerRadius="8" 
                   Padding="12,6" 
                   HorizontalOptions="Start"
                   IsVisible="{Binding EsReservado}"> 
                <Label Text="PRODUCTO RESERVADO" 
                       TextColor="White" 
                       FontAttributes="Bold" 
                       FontSize="13" />
            </Frame>

            <VerticalStackLayout Spacing="5">
                <Label Text="{Binding Nombre}" FontSize="26" FontAttributes="Bold" TextColor="Black" />
                <Label Text="{Binding Precio, StringFormat='{0} €'}" FontSize="24" TextColor="#2ecc71" FontAttributes="Bold" />
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="#F0F0F0" />

            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <Label Text="Estado:" FontAttributes="Bold" TextColor="Gray" FontSize="16"/>
                <Frame Padding="10,4" CornerRadius="10" BackgroundColor="#E8F4FD" BorderColor="Transparent">
                    <Label Text="{Binding Estado}" TextColor="#3498db" FontSize="13" FontAttributes="Bold" />
                </Frame>
            </HorizontalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Descripción" FontAttributes="Bold" FontSize="18" TextColor="Black" />
                <Label Text="{Binding Descripcion}" FontSize="16" TextColor="#444" LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8" Margin="0,10,0,0">
                <Label Text="Características Técnicas" FontAttributes="Bold" FontSize="18" TextColor="Black" />
                <Label Text="{Binding Caracteristicas}" FontSize="15" TextColor="#666" LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="#F0F0F0" Margin="0,10" />

            <Grid ColumnDefinitions="*, 60"
                  ColumnSpacing="15"
                  Margin="0,10,0,20">

                <Button Grid.Column="0"
                        Text="CHATEAR CON EL VENDEDOR"
                        Clicked="OnChatClicked" 
                        BackgroundColor="DarkViolet" 
                        TextColor="White"
                        HeightRequest="55"
                        CornerRadius="15"
                        FontAttributes="Bold"
                        FontSize="14" />

                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 15"
                        BackgroundColor="#F8F8F8"
                        StrokeThickness="0">
                    <Image Source="{Binding IconoFavorito}"
                           HeightRequest="30"
                           WidthRequest="30"
                           VerticalOptions="Center"
                           HorizontalOptions="Center">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFavoritoClicked" />
                        </Image.GestureRecognizers>
                    </Image>
                </Border>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>