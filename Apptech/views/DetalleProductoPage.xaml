<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Apptech.views.DetalleProductoPage"
             Title="Detalle del Producto">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Image Source="{Binding ImagenUrl}" HeightRequest="250" Aspect="AspectFill" />

            <Frame BackgroundColor="Red" 
                   BorderColor="Transparent"
                   CornerRadius="5" 
                   Padding="10,5" 
                   HorizontalOptions="Start"
                   IsVisible="{Binding EsVendido}"> 
                <Label Text="PRODUCTO RESERVADO" 
                       TextColor="White" 
                       FontAttributes="Bold" 
                       FontSize="14" />
            </Frame>

            <Label Text="{Binding Nombre}" FontSize="24" FontAttributes="Bold" />
            <Label Text="{Binding Precio, StringFormat='{0} €'}" FontSize="22" TextColor="Green" FontAttributes="Bold" />

            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,5" />

            <Label Text="Descripción" FontAttributes="Bold" FontSize="18" />
            <Label Text="{Binding Descripcion}" FontSize="16" />

            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,20" />
            <Grid ColumnDefinitions="4*, 1*"
                ColumnSpacing="10"
                IsVisible="{Binding PuedeComprar}">

                <!-- BOTÓN COMPRAR -->
                <Button Grid.Column="0"
                        Text="COMPRAR AHORA"
                        Clicked="OnComprarClicked"
                        BackgroundColor="DarkViolet"
                        TextColor="White"
                        HeightRequest="50"
                        CornerRadius="10"
                        FontAttributes="Bold" />

                <!-- CORAZÓN FAVORITO -->
                <Image Grid.Column="1"
                    Source="{Binding IconoFavorito}"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">

                    <Image.GestureRecognizers>
                        <TapGestureRecognizer  Tapped="OnFavoritoClicked" />
                    </Image.GestureRecognizers>

                </Image>

            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>