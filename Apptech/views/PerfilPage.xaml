<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Apptech.views.PerfilPage"
             x:Name="Root"
             BackgroundColor="White">

    <Grid ColumnDefinitions="*"
          RowDefinitions="Auto, Auto, Auto, *"
          RowSpacing="20"
          Padding="0,10,0,20"
          HorizontalOptions="Fill">

        <!-- FOTO PERFIL -->
        <Border Grid.Row="0"
                HorizontalOptions="Center"
                WidthRequest="120"
                HeightRequest="120"
                BackgroundColor="#F5F5F5"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 60">

            <Image Source="{Binding Source={x:Reference Root}, Path=Perfil_url}"
                   Aspect="AspectFill">

                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="CambiarFoto" />
                </Image.GestureRecognizers>

            </Image>
        </Border>

        <!-- NOMBRE -->
        <Label Grid.Row="1"
               Text="{Binding Source={x:Reference Root}, Path=NombreUsuario}"
               FontSize="20"
               FontAttributes="Bold"
               TextColor="#333333"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"/>

        <!-- SELECTOR -->
        <HorizontalStackLayout Grid.Row="2"
                               HorizontalOptions="Center"
                               Spacing="15">

            <Button Text="Productos"
                   Command="{Binding Source={x:Reference Root}, Path=MostrarProductosCommand}"/>

            <Button Text="Favoritos"
                    Command="{Binding Source={x:Reference Root}, Path=MostrarFavoritosCommand}" />

        </HorizontalStackLayout>

        <!-- PRODUCTOS (REUTILIZADO) -->
        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Source={x:Reference Root}, Path=ItemsActivos}"
                        VerticalOptions="FillAndExpand">

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="2"
                                 HorizontalItemSpacing="10"
                                 VerticalItemSpacing="10"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border Margin="2"
                            BackgroundColor="#F5F5F5"
                            StrokeShape="RoundRectangle 15"
                            StrokeThickness="0">

                        <VerticalStackLayout Padding="10" Spacing="5">

                            <Image Source="{Binding ImagenUrl}"
                                   Aspect="AspectFill"
                                   HeightRequest="120"
                                   HorizontalOptions="Fill"/>

                            <Label Text="{Binding Nombre}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#333"
                                   MaxLines="1"
                                   LineBreakMode="TailTruncation"/>

                            <Label Text="{Binding Precio, StringFormat='{0:F2} €'}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#2ECC71"/>

                                   <HorizontalStackLayout Spacing="10">

                            <Button Text="Editar"
                                        FontSize="12"
                                        BackgroundColor="#3498DB"
                                        TextColor="White"
                                        Command="{Binding Source={x:Reference Root}, Path=EditarProductoCommand}"
                                        CommandParameter="{Binding .}" />

                            <Button Text="Eliminar"
                                        FontSize="12"
                                        BackgroundColor="#E74C3C"
                                        TextColor="White"
                                        Command="{Binding Source={x:Reference Root}, Path=EliminarProductoCommand}"
                                        CommandParameter="{Binding .}" />

                            </HorizontalStackLayout>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentView>