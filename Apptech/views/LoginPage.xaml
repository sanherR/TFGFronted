<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Apptech.LoginPage"
             BackgroundColor="#F5F5F5"> <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25" VerticalOptions="Center">
            
            <Image Source="dotnet_bot.png"
                   HeightRequest="150"
                   Aspect="AspectFit" />

            <Border Stroke="Transparent"
                    BackgroundColor="White"
                    Padding="20"
                    Margin="10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>
                
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,5" Radius="10" Opacity="0.1" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="20">
                    <Label Text="INICIAR SESIÓN"
                           HorizontalTextAlignment="Center"
                           FontSize="24"
                           TextColor="#333333"
                           FontAttributes="Bold" />

                    <Border StrokeThickness="1" Stroke="#E0E0E0" StrokeShape="RoundRectangle 8" Padding="10,0">
                         <Entry Placeholder="Usuario" HeightRequest="45" />
                    </Border>

                    <Border StrokeThickness="1" Stroke="#E0E0E0" StrokeShape="RoundRectangle 8" Padding="10,0">
                         <Entry Placeholder="Contraseña" IsPassword="True" HeightRequest="45" />
                    </Border>

                    <Button Text="Iniciar Sesión"
                            BackgroundColor="#003366"
                            TextColor="White"
                            HeightRequest="50"
                            CornerRadius="8" />

                    <Label Text="¿No tienes cuenta? Regístrate aquí"
                           TextColor="Blue"
                           HorizontalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRegisterTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>