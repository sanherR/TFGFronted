<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Apptech.views.LoginPage"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4A148C" Offset="0.0" />
            <GradientStop Color="#29B6F6" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <Grid ColumnDefinitions="0.08*, 0.84*, 0.08*" 
              RowDefinitions="Auto, Auto, Auto"
              Padding="0, 40, 0, 30"
              VerticalOptions="Center"> <Image Grid.Row="0" Grid.Column="1"
                   Source="dotnet_bot.png"
                   HeightRequest="180"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Margin="0,0,0,10" />

            <Border Grid.Row="1" Grid.Column="1"
                    BackgroundColor="#F8F9FA"
                    Padding="24, 30, 24, 30"
                    StrokeThickness="0"
                    Margin="0,10,0,20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="30" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,15" Radius="25" Opacity="0.25" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="22">
                    
                    <Label Text="¡BIENVENIDO!"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#212121"
                           CharacterSpacing="1.5"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,5" />

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Correo electrónico" 
                               FontSize="13" 
                               FontAttributes="Bold"
                               TextColor="#5E6E7C" 
                               Margin="4,0"/>
                        <Border Stroke="#E0E6ED" StrokeThickness="1.5" StrokeShape="RoundRectangle 16" Padding="15,0" BackgroundColor="White">
                            <Entry x:Name="txtEmail" 
                                   Placeholder="ejemplo@correo.com" 
                                   PlaceholderColor="#A0AAB5"
                                   TextColor="#2C3E50"
                                   HeightRequest="50" 
                                   Keyboard="Email" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Contraseña" 
                               FontSize="13" 
                               FontAttributes="Bold"
                               TextColor="#5E6E7C" 
                               Margin="4,0"/>
                        <Border Stroke="#E0E6ED" StrokeThickness="1.5" StrokeShape="RoundRectangle 16" Padding="15,0" BackgroundColor="White">
                            <Entry x:Name="txtPassword" 
                                   Placeholder="******" 
                                   PlaceholderColor="#A0AAB5"
                                   TextColor="#2C3E50"
                                   IsPassword="True" 
                                   HeightRequest="50" />
                        </Border>
                    </VerticalStackLayout>

                    <Button Clicked="OnRegisterTapped2"
                            Text="INICIAR SESIÓN"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="15"
                            CharacterSpacing="1"
                            BackgroundColor="#4A148C"
                            HeightRequest="55"
                            CornerRadius="18"
                            Margin="0,10,0,0" />
                </VerticalStackLayout>
            </Border>

            <Label Grid.Row="2" Grid.Column="1" 
                   HorizontalOptions="Center" 
                   FontSize="14"
                   Margin="0,10,0,0">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="¿No tienes cuenta? " TextColor="#E0F7FA" />
                        <Span Text="Regístrate" TextColor="White" FontAttributes="Bold" TextDecorations="Underline">
                            <Span.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRegisterTapped"/>
                            </Span.GestureRecognizers>
                        </Span>
                    </FormattedString>
                </Label.FormattedText>
            </Label>

        </Grid>
    </ScrollView>
</ContentPage>