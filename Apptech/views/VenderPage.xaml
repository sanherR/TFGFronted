<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Apptech.views.VenderPage"
             Title="Publicar Producto"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Información del Producto" FontSize="20" FontAttributes="Bold" />

            <!-- Nombre -->
            <Entry x:Name="NombreEntry" Placeholder="Nombre del producto" />
            
            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                <Entry x:Name="PrecioEntry" Grid.Column="0" Placeholder="Precio (€)" Keyboard="Numeric" />
                <Entry x:Name="StockEntry" Grid.Column="1" Placeholder="Stock" Keyboard="Numeric" Text="1" />
            </Grid>

            <!-- SELECTOR DE CATEGORÍA -->
            <Label Text="Categoría" FontAttributes="Bold" Margin="0,5,0,0"/>
            <Picker x:Name="CategoriaPicker" Title="Selecciona una categoría" ItemDisplayBinding="{Binding Nombre}" />

            <!-- SELECTOR DE ESTADO -->
            <Label Text="Estado del producto" FontAttributes="Bold" Margin="0,5,0,0"/>
            <Picker x:Name="EstadoPicker" Title="¿En qué estado está?">
                <Picker.Items>
                    <x:String>Nuevo</x:String>
                    <x:String>Como nuevo</x:String>
                    <x:String>Buen estado</x:String>
                    <x:String>Aceptable</x:String>
                    <x:String>Para piezas</x:String>
                </Picker.Items>
            </Picker>

            <Entry x:Name="DescripcionEntry" Placeholder="Descripción corta (ej: Vendo por falta de uso)" />

            <!-- CARACTERÍSTICAS TÉCNICAS -->
            <Label Text="Especificaciones técnicas" FontAttributes="Bold" Margin="0,5,0,0"/>
            <Editor x:Name="CaracteristicasEditor" 
                    Placeholder="Ej: Procesador i7, 16GB RAM, SSD 512GB..." 
                    HeightRequest="100" 
                    AutoSize="TextChanges" />
            
            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,10" />

            <Button Text="SELECCIONAR IMAGEN" 
                    Clicked="BtnSeleccionarImagen_Clicked" 
                    BackgroundColor="#3498db" 
                    TextColor="White" />

            <Button Text="PUBLICAR PRODUCTO" 
                    Clicked="BtnAgregarProducto_Clicked" 
                    BackgroundColor="Green" 
                    TextColor="White"
                    FontAttributes="Bold" 
                    HeightRequest="50" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>