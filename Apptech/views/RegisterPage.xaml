<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Apptech.views.RegisterPage"
             Title="Crear Cuenta"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">
            
            <Image Source="logo_infomercado.png"
                   HeightRequest="150"
                   Aspect="AspectFit"
                   HorizontalOptions="Center" />

            <Label Text="REGISTRARSE"
                   HorizontalTextAlignment="Center"
                   FontSize="28"
                   TextColor="#003366"
                   FontAttributes="Bold" />

            <Border Stroke="#003366" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="10,0">
                <Entry x:Name="txtUsuario" Placeholder="Nombre de usuario" />
            </Border>

            <Border Stroke="#003366" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="10,0">
              <Entry x:Name="txtEmail" Placeholder="Correo" Keyboard="Email" />
            </Border>

            <Border Stroke="#003366" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="10,0">
                <Entry x:Name="txtPassword" Placeholder="Contraseña" IsPassword="True" />

            </Border>

            <Border Stroke="#003366" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="10,0">
                <Entry x:Name="txtConfirmPassword" Placeholder="Confirmar contraseña" IsPassword="True" />
            </Border>

            <Button Text="CREAR CUENTA"
                    BackgroundColor="#003366"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="55"
                    Margin="0,10,0,0" />

        </VerticalStackLayout> 
    </ScrollView>
</ContentPage>