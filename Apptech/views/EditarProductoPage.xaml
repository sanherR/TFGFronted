<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Apptech.views.EditarProductoPage"
             Title="Editar Producto"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            
            <Label Text="Editar Información" 
                   FontSize="22" 
                   FontAttributes="Bold" 
                   TextColor="Black" 
                   HorizontalOptions="Center" 
                   Margin="0,0,0,10"/>

            <VerticalStackLayout Spacing="5">
                <Label Text="Nombre del Producto" FontAttributes="Bold" TextColor="Gray" />
                <Entry Text="{Binding Nombre}" 
                       Placeholder="Ej: iPhone 15 Pro" 
                       BackgroundColor="#F9F9F9" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Descripción" FontAttributes="Bold" TextColor="Gray" />
                <Editor Text="{Binding Descripcion}" 
                        Placeholder="Cuéntanos más sobre el producto..." 
                        AutoSize="TextChanges" 
                        MinimumHeightRequest="80"
                        BackgroundColor="#F9F9F9" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Precio (€)" FontAttributes="Bold" TextColor="Gray" />
                <Entry Text="{Binding Precio}" 
                       Placeholder="0.00" 
                       Keyboard="Numeric"
                       BackgroundColor="#F9F9F9" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                <VerticalStackLayout Grid.Column="0" Spacing="5">
                    <Label Text="Categoría" FontAttributes="Bold" TextColor="Gray" />
                    <Picker x:Name="CategoriaPicker" 
                            Title="Seleccionar" 
                            ItemDisplayBinding="{Binding Nombre}"
                            BackgroundColor="#F9F9F9" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="5">
                    <Label Text="Estado" FontAttributes="Bold" TextColor="Gray" />
                    <Picker x:Name="EstadoPicker" 
                            Title="Seleccionar"
                            SelectedItem="{Binding Estado_producto}"
                            BackgroundColor="#F9F9F9">
                        <Picker.Items>
                            <x:String>Nuevo</x:String>
                            <x:String>Como nuevo</x:String>
                            <x:String>Buen estado</x:String>
                            <x:String>Aceptable</x:String>
                            <x:String>Para piezas</x:String>
                        </Picker.Items>
                    </Picker>
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Spacing="5">
                <Label Text="Especificaciones técnicas" FontAttributes="Bold" TextColor="Gray" />
                <Editor Text="{Binding Caracteristicas}" 
                        Placeholder="Memoria, procesador, dimensiones..." 
                        HeightRequest="100"
                        BackgroundColor="#F9F9F9" />
            </VerticalStackLayout>

            <Label Text="Imagen del producto" FontAttributes="Bold" TextColor="Gray" />
            <Border StrokeShape="RoundRectangle 15" StrokeThickness="0" HeightRequest="200">
                <Image Source="{Binding ImagenPreview}" Aspect="AspectFill" />
            </Border>

            <Button Text="CAMBIAR FOTO" 
                    Command="{Binding CambiarImagenCommand}" 
                    BackgroundColor="#3498DB" 
                    TextColor="White" 
                    FontAttributes="Bold"
                    CornerRadius="10" />

            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,10" />

            <Button Text="GUARDAR CAMBIOS" 
                    Command="{Binding GuardarCommand}" 
                    BackgroundColor="#2ECC71" 
                    TextColor="White" 
                    HeightRequest="55"
                    CornerRadius="15" 
                    FontAttributes="Bold"
                    FontSize="16"
                    Margin="0,0,0,30" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>