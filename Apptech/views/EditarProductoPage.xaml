<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Apptech.views.EditarProductoPage"
             Title="Editar Producto">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Información del Producto" FontSize="20" FontAttributes="Bold" />

            <Label Text="Nombre" FontAttributes="Bold" />
            <Entry Text="{Binding Nombre}" Placeholder="Nombre" />

            <Label Text="Descripción" FontAttributes="Bold" />
            <Editor Text="{Binding Descripcion}" Placeholder="Descripción" AutoSize="TextChanges" />

            <Label Text="Precio (€)" FontAttributes="Bold" />
            <Entry Text="{Binding Precio}" Placeholder="Precio" Keyboard="Numeric"/>

            <Label Text="Categoría" FontAttributes="Bold" />
            <Picker x:Name="CategoriaPicker" 
                    Title="Selecciona una categoría" 
                    ItemDisplayBinding="{Binding Nombre}" />

            <Label Text="Estado del producto" FontAttributes="Bold" />
            <Picker x:Name="EstadoPicker" Title="¿En qué estado está?">
                <Picker.Items>
                    <x:String>Nuevo</x:String>
                    <x:String>Como nuevo</x:String>
                    <x:String>Buen estado</x:String>
                    <x:String>Aceptable</x:String>
                    <x:String>Para piezas</x:String>
                </Picker.Items>
            </Picker>

            <Label Text="Especificaciones técnicas" FontAttributes="Bold" />
            <Editor Text="{Binding Caracteristicas}" 
                    Placeholder="Características..." 
                    HeightRequest="100" />

            <Image Source="{Binding ImagenPreview}" HeightRequest="200" Aspect="AspectFill" />

            <Button Text="Cambiar imagen" 
                    Command="{Binding CambiarImagenCommand}" 
                    BackgroundColor="#3498DB" 
                    TextColor="White" />

            <Button Text="Guardar cambios" 
                    Command="{Binding GuardarCommand}" 
                    BackgroundColor="Green" 
                    TextColor="White" 
                    FontAttributes="Bold" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>