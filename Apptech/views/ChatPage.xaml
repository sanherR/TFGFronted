<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Apptech.Models"
             x:Class="Apptech.views.ChatPage"
             Title="{Binding TituloChat}">

    <Grid RowDefinitions="Auto, *, Auto">
        <Border Grid.Row="0" 
                BackgroundColor="#F8F8F8" 
                IsVisible="{Binding MostrarInfoProducto}"
                Padding="10"
                StrokeThickness="0">
            <Grid ColumnDefinitions="50, *, Auto" ColumnSpacing="12">
                <Border Grid.Column="0" StrokeShape="RoundRectangle 8" HeightRequest="50" WidthRequest="50">
                    <Image Source="{Binding ImagenProducto}" Aspect="AspectFill"/>
                </Border>
                
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="{Binding NombreProducto}" FontAttributes="Bold" MaxLines="1" TextColor="Black"/>
                    <Label Text="{Binding PrecioProducto, StringFormat='{0} €'}" TextColor="#2ecc71" FontAttributes="Bold"/>
                </VerticalStackLayout>

                <StackLayout Grid.Column="2" VerticalOptions="Center">
                    
                    <Button x:Name="BotonReservar" 
                            Text="Reservar" 
                            Clicked="OnReservarClicked"
                            BackgroundColor="#3498db" 
                            TextColor="White" 
                            CornerRadius="15" 
                            HeightRequest="35"
                            IsVisible="True"/>

                    <Grid x:Name="GridAccionesVendedor" 
                          ColumnDefinitions="Auto, Auto" 
                          ColumnSpacing="5" 
                          IsVisible="False">
                        
                        <Button Grid.Column="0"
                                Text="Vender" 
                                Clicked="OnConfirmarVentaClicked"
                                BackgroundColor="#2ecc71" 
                                TextColor="White" 
                                CornerRadius="15" 
                                HeightRequest="35"
                                Padding="10,0"/>

                        <Button Grid.Column="1"
                                Text="Anular" 
                                Clicked="OnReservarClicked"
                                BackgroundColor="#e74c3c" 
                                TextColor="White" 
                                CornerRadius="15" 
                                HeightRequest="35"
                                Padding="10,0"/>
                    </Grid>

                    <Label x:Name="LabelVendido" 
                           Text="Vendido" 
                           TextColor="Gray" 
                           FontAttributes="Bold" 
                           IsVisible="False"
                           HorizontalOptions="Center"/>
                </StackLayout>
            </Grid>
        </Border>
        
        <CollectionView x:Name="MessagesList" Grid.Row="1" ItemsSource="{Binding Mensajes}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="2" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Mensaje">
                    <Grid Padding="10,2">
                        <VerticalStackLayout HorizontalOptions="{Binding Alineacion}">
                            <Frame BackgroundColor="{Binding ColorBurbuja}" 
                                   Padding="12,8" CornerRadius="15" HasShadow="False" BorderColor="Transparent">
                                <Label Text="{Binding Contenido}" TextColor="Black" FontSize="15" />
                            </Frame>
                            <Label Text="{Binding Fecha, StringFormat='{0:HH:mm}'}" FontSize="10" TextColor="Gray" Margin="5,0"/>
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="2" Padding="10" BackgroundColor="White" StrokeThickness="1" Stroke="#E0E0E0">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                <Entry x:Name="TxtMensaje" Placeholder="Escribe un mensaje..." Keyboard="Chat" />
                <Button Grid.Column="1" Text="Enviar" Clicked="OnEnviarClicked" 
                        BackgroundColor="DarkViolet" TextColor="White" CornerRadius="20" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>