<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Apptech.views"
             xmlns:selectors="clr-namespace:Apptech.selectors"
             x:Class="Apptech.views.MainPage"
             Shell.NavBarIsVisible="False" 
             BackgroundColor="White">
    
    <ContentPage.Resources>
        <selectors:MainSelector x:Key="TemplateSelector">

            <selectors:MainSelector.ProductosTemplate>
                <DataTemplate>
                    <views:ProductosPage/>
                </DataTemplate>
            </selectors:MainSelector.ProductosTemplate>

            <selectors:MainSelector.ProductosCategoriaTemplate>
                <DataTemplate>
                    <ContentView>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                            <ActivityIndicator IsRunning="True" Color="DeepSkyBlue" />
                            <Label Text="Cargando categorías..." 
                                   HorizontalTextAlignment="Center" 
                                   TextColor="Gray" />
                        </VerticalStackLayout>
                    </ContentView>
                </DataTemplate>
            </selectors:MainSelector.ProductosCategoriaTemplate>

            <selectors:MainSelector.ChatTemplate>
                <DataTemplate>
                    <views:ListaChatsPage/> 
                </DataTemplate>
            </selectors:MainSelector.ChatTemplate>

            <selectors:MainSelector.PerfilTemplate>
                <DataTemplate>
                    <views:PerfilPage/>
                </DataTemplate>
            </selectors:MainSelector.PerfilTemplate>

        </selectors:MainSelector>
    </ContentPage.Resources>

    <Grid RowDefinitions="*, Auto">
        
        <CarouselView x:Name="miCarrusel"
                      Grid.Row="0"
                      Loop="False"
                      Position="0" 
                      IsSwipeEnabled="False"
                      PositionChanged="OnPositionChanged"
                      ItemTemplate="{StaticResource TemplateSelector}">
            <CarouselView.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>Productos</x:String>
                    <x:String>Categorias</x:String>
                    <x:String>Chat</x:String>
                    <x:String>Perfil</x:String>
                </x:Array>
            </CarouselView.ItemsSource>
        </CarouselView>

        <ImageButton Source="abc_ic_ab_back_material.png" 
                     HorizontalOptions="Start"
                     VerticalOptions="Start"
                     Margin="20, 15, 0, 0" 
                     HeightRequest="40"
                     WidthRequest="40"
                     Padding="8"
                     CornerRadius="20"
                     BackgroundColor="#E6FFFFFF" 
                     Clicked="OnVolverAlLoginClicked">
            <ImageButton.Shadow>
                <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.15" />
            </ImageButton.Shadow>
        </ImageButton>

        <ImageButton Source="icono_menu.png" 
                     Grid.Row="0"
                     HorizontalOptions="Start"
                     VerticalOptions="End"
                     Margin="20, 0, 0, 85" 
                     HeightRequest="45"
                     WidthRequest="45"
                     CornerRadius="22"
                     BackgroundColor="White"
                     Padding="10" />

        <Grid Grid.Row="1"
              BackgroundColor="Transparent" 
              VerticalOptions="End" 
              Padding="15, 0, 15, 10"> 
            <Border BackgroundColor="White"       
                    Padding="10"
                    StrokeThickness="0"> 
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="30" />
                </Border.StrokeShape>
                
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,10" Radius="20" Opacity="0.1" />
                </Border.Shadow>

                <Grid ColumnDefinitions="*, *, *, *, *">
                    <ImageButton Source="icono_casa.png" 
                                 Grid.Column="0" 
                                 HeightRequest="32" 
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Clicked="IrAProductos" />
                    
                    <ImageButton Source="icono_busqueda_categoria.png" 
                                 Grid.Column="1" 
                                 HeightRequest="32" 
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Clicked="IrABusqueda" />
                    
                    <ImageButton Source="icono_vender.png" 
                                 Grid.Column="2" 
                                 HeightRequest="70" 
                                 Clicked="IrAVender"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"/>
                    
                    <ImageButton Source="icono_chat.png" 
                                 Grid.Column="3" 
                                 HeightRequest="32" 
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Clicked="IrAChat" />
                    
                    <ImageButton Source="icono_perfil.png" 
                                 Grid.Column="4" 
                                 HeightRequest="32" 
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Clicked="IrAPerfil" />
                </Grid>
            </Border>
        </Grid>
    </Grid> 
</ContentPage>